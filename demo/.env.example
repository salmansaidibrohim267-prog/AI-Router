# ============================================================
# AI Router demo — environment variables
# Copy to demo/.env and fill in at least one provider key:
#   cp demo/.env.example demo/.env
# ============================================================

# --- Provider API keys (optional — only add keys you use) ---
# Ollama is the zero-key option: run `ollama serve` locally (http://localhost:11434)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- Server ---
# Port exposed on the host (default 8000)
PORT=8000
LOG_LEVEL=info

# --- Demo extras (optional) ---
# CORS / host guards
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Distributed mode (0 = standalone demo)
DISTRIBUTED_MODE=0