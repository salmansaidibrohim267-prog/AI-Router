# Example provider configuration for AI Router.
# Copy to config/providers.yaml (or merge with it) and set at least one
# API key in your environment. Field names match config/providers.yaml.

providers:
  - name: openrouter
    display_name: "OpenRouter"
    api_key_env: "OPENROUTER_API_KEY"
    base_url: "https://openrouter.ai/api/v1"
    timeout: 60.0
    max_retries: 3
    enabled: true
    priority: 10
    models:
      - "openai/gpt-4o-mini"
      - "anthropic/claude-3.5-sonnet"

  - name: ollama
    display_name: "Ollama (Local)"
    api_key_env: null
    base_url: "http://localhost:11434"
    timeout: 120.0
    max_retries: 3
    enabled: true
    priority: 20
    models:
      - "llama3.2"
      - "qwen2.5:3b"

  - name: openai
    display_name: "OpenAI"
    api_key_env: "OPENAI_API_KEY"
    base_url: "https://api.openai.com/v1"
    timeout: 60.0
    max_retries: 3
    enabled: true
    priority: 30
    models:
      - "gpt-4o-mini"
      - "gpt-4o"

  - name: anthropic
    display_name: "Anthropic"
    api_key_env: "ANTHROPIC_API_KEY"
    base_url: "https://api.anthropic.com/v1"
    timeout: 60.0
    max_retries: 3
    enabled: true
    priority: 40
    models:
      - "claude-3-5-haiku-latest"
      - "claude-3-5-sonnet-latest"

  - name: google
    display_name: "Google"
    api_key_env: "GOOGLE_API_KEY"
    base_url: "https://generativelanguage.googleapis.com/v1beta"
    timeout: 60.0
    max_retries: 3
    enabled: true
    priority: 50
    models:
      - "gemini-2.0-flash"
      - "gemini-1.5-pro"

# Notes
# - `api_key_env: null` marks a keyless provider (e.g. local Ollama).
# - Lower `priority` wins; the routing engine still re-ranks per request.
# - After editing, apply with: POST /reload-config
