>     def with_retry(
>         self,
>         func: Callable[..., Coroutine[Any, Any, Any]],
>         max_retries: int = 2,
>         retry_delay: float = 0.5,
>     ) -> Callable[..., Coroutine[Any, Any, Any]]:
>         async def wrapper(*args: Any, **kwargs: Any) -> Any:
>             last_exc: Exception | None = None
