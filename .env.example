# API Keys (optional - only add keys for providers you use)
# Can also be provided via Docker Secrets at /run/secrets/<NAME>
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Security (optional)
CORS_ORIGINS=*
ALLOWED_HOSTS=*
MAX_REQUEST_SIZE_BYTES=10485760

# Redis (optional - for distributed deployments)
# REDIS_URL=redis://redis:6379/0

# Docker Build Metadata (set at build time)
# BUILD_DATE=2025-01-01T00:00:00Z
# GIT_COMMIT=abc1234
