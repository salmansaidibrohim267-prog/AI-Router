# API Keys (optional - only add keys for providers you use)
# Can also be provided via Docker Secrets at /run/secrets/<NAME>
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Security (optional)
CORS_ORIGINS=*
ALLOWED_HOSTS=*
MAX_REQUEST_SIZE_BYTES=10485760

# Redis (required for distributed mode)
REDIS_URL=redis://default:${REDIS_PASSWORD:-}@redis:6379/0
REDIS_PASSWORD=

# Distributed Mode (set to 1 to enable)
DISTRIBUTED_MODE=0

# Worker Configuration
WORKER_COUNT=2
WORKER_CONCURRENCY=5
LEASE_TIMEOUT=30
HEARTBEAT_INTERVAL=5

# Scheduler
LOCK_TIMEOUT=10
SCHEDULER_MODE=0

# Event Bus
EVENT_BUS_ENABLED=1

# OpenTelemetry
OTEL_ENABLED=0
OTEL_SERVICE_NAME=ai-router
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318/v1/traces

# Queue
QUEUE_BACKEND=redis
MAX_RETRY=3
DLQ_ENABLED=1

# Knowledge Foundation (Stage 9.1)
KNOWLEDGE_STORAGE_BACKEND=sqlite
KNOWLEDGE_DATABASE_PATH=knowledge.db

# Knowledge Ingestion (Stage 9.2)
DOCUMENT_MAX_SIZE=10485760
SUPPORTED_DOCUMENT_TYPES=.txt,.md,.mdx,.pdf,.html,.htm,.json
ALLOW_DUPLICATE_DOCUMENT=0
DEFAULT_LANGUAGE=en

# Knowledge Chunking (Stage 9.3)
CHUNK_STRATEGY=fixed
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=2000
TOKEN_ESTIMATOR=heuristic

# Knowledge Embedding (Stage 9.4)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRY=3
EMBEDDING_CACHE_ENABLED=1
EMBEDDING_CACHE_TTL=3600

# Knowledge Vector Store (Stage 9.5)
VECTOR_BACKEND=memory
VECTOR_COLLECTION=knowledge_vectors
VECTOR_NAMESPACE=default
VECTOR_DISTANCE=cosine
VECTOR_BATCH_SIZE=64
VECTOR_TIMEOUT=30
VECTOR_MAX_RETRY=3

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=0

# Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_AUTH=

# pgvector
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/vectordb
PGVECTOR_TABLE=vectors
PGVECTOR_POOL_SIZE=10

# Redis Vector
REDIS_URL=redis://localhost:6379/0

# Knowledge Reranker (Stage 9.8)
RERANKER_PROVIDER=rule_based
RERANKER_MODEL=
RERANKER_TOP_K_RETRIEVE=50
RERANKER_TOP_K_RERANK=10
RERANKER_TOP_K_RETURN=10
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_CACHE_ENABLED=1
RERANKER_CACHE_TTL=3600
RERANKER_CACHE_MAX_SIZE=10000
RERANKER_CALIBRATION=min_max
RERANKER_TIMEOUT=30
RERANKER_MAX_RETRY=3
RERANKER_LOG_QUERIES=1
RERANKER_TRACK_METRICS=1

# Cross-Encoder / Model Backends
RERANKER_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_OPENAI_MODEL=text-embedding-3-small
RERANKER_COHERE_MODEL=rerank-english-v3.0
RERANKER_JINA_MODEL=jina-reranker-v2-base-multilingual
RERANKER_BGE_MODEL=BAAI/bge-reranker-v2-m3

# Ensemble weights (comma-separated, one per sub-reranker)
RERANKER_ENSEMBLE_WEIGHTS=

# Docker Build Metadata (set at build time)
# BUILD_DATE=2025-01-01T00:00:00Z
# GIT_COMMIT=abc1234
