{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "title": "AI Router - Production Overview",
  "description": "Comprehensive monitoring dashboard for AI Router Gateway",
  "tags": ["ai-router", "production", "llm-gateway"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "panels": [
    {
      "title": "Request Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_total[5m]))",
          "legendFormat": "req/s",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Overall request rate across all providers"
    },
    {
      "title": "Success Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_success[5m])) / sum(rate(ai_router_request_total[5m])) * 100",
          "legendFormat": "%",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "percent",
      "description": "Request success rate over the last 5 minutes"
    },
    {
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "ai_router_active_requests",
          "legendFormat": "active",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Currently in-flight requests"
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "ai_router_uptime_seconds",
          "legendFormat": "uptime",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "s",
      "description": "Router uptime in seconds"
    },
    {
      "title": "Rate Limited",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_rate_limit_total[5m]))",
          "legendFormat": "rate limited/s",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Rate limited requests per second"
    },
    {
      "title": "Total Cost (USD)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "targets": [
        {
          "expr": "sum(ai_router_cost_usd_total)",
          "legendFormat": "total cost",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "currencyusd",
      "description": "Total accumulated cost in USD"
    },
    {
      "title": "Requests by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_total[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Request rate broken down by provider"
    },
    {
      "title": "Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ai_router_provider_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_router_provider_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ai_router_provider_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "s",
      "description": "Request latency percentiles across all providers"
    },
    {
      "title": "Provider Health",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "ai_router_provider_health",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": {}, "renameByName": { "Value": "Healthy" } } }
      ],
      "description": "Current health status of each provider"
    },
    {
      "title": "Provider Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "ai_router_provider_latency_ms",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "ms",
      "description": "Current latency per provider in milliseconds"
    },
    {
      "title": "Error Rate by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_failed[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Failed request rate broken down by provider"
    },
    {
      "title": "Error Types Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_failed[5m])) by (error_type)",
          "legendFormat": "{{error_type}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Failed requests broken down by error type"
    },
    {
      "title": "Token Consumption",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_tokens_total[5m])) by (type)",
          "legendFormat": "{{type}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Token consumption rate by type (prompt/completion)"
    },
    {
      "title": "Cost by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_cost_usd_total[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "unit": "currencyusd",
      "description": "Cost accumulation rate by provider"
    },
    {
      "title": "Circuit Breaker State",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 38 },
      "targets": [
        {
          "expr": "ai_router_circuit_breaker_state",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": { "Value": "State", "provider": "Provider" }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Status",
            "mode": "replaceAllFields",
            "reduce": { "reducers": ["last"] },
            "replaceWithDefinition": {
              "expression": "case when $State = 0 then 'Closed' when $State = 1 then 'Half-Open' when $State = 2 then 'Open' else 'Unknown' end"
            }
          }
        }
      ],
      "description": "Circuit breaker state for each provider (0=Closed, 1=Half-Open, 2=Open)"
    },
    {
      "title": "Fallback Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 38 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_fallback_total[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Fallback rate broken down by provider"
    },
    {
      "title": "Cache Hit / Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_cache_hit[5m])) by (cache_name)",
          "legendFormat": "hit: {{cache_name}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "sum(rate(ai_router_cache_miss[5m])) by (cache_name)",
          "legendFormat": "miss: {{cache_name}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Cache hit and miss rates"
    },
    {
      "title": "Request Rate by Task",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_request_total[5m])) by (task)",
          "legendFormat": "{{task}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Request rate broken down by task type"
    },
    {
      "title": "Traffic Distribution Weights",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "targets": [
        {
          "expr": "ai_router_distribution_weight",
          "legendFormat": "{{provider}}/{{model}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Current traffic distribution weight per provider"
    },
    {
      "title": "Distribution Selections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 52 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_distribution_selections_total[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Request distribution rate per provider over time"
    },
    {
      "title": "Canary Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 60 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_canary_traffic_total[5m])) by (provider, model)",
          "legendFormat": "{{provider}}/{{model}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Canary rollout traffic volume"
    },
    {
      "title": "Shadow Traffic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 60 },
      "targets": [
        {
          "expr": "sum(rate(ai_router_shadow_traffic_total[5m])) by (provider, model)",
          "legendFormat": "{{provider}}/{{model}}",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ],
      "description": "Shadow request volume for comparison testing"
    },
    {
      "title": "Recent Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 52 },
      "targets": [
        {
          "expr": "{job=\"ai-router\"} |= ``",
          "legendFormat": "",
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" }
        }
      ],
      "description": "Live log stream from Loki"
    }
  ],
  "schemaVersion": 38,
  "version": 1,
  "links": [],
  "time": { "from": "now-1h", "to": "now" }
}
